#!/usr/bin/env bash
# Entry point for the AI Orchestration Broker
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

if [[ -f "${SCRIPT_DIR}/.venv/bin/python" ]]; then
  PYTHON_EXE="${SCRIPT_DIR}/.venv/bin/python"
else
  PYTHON_EXE="python3"
fi

cd "${SCRIPT_DIR}"
exec "${PYTHON_EXE}" -m backend.broker "$@"
